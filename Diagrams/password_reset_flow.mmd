flowchart TD
    %% Styling Classes
    classDef client fill:#f1f8e9,stroke:#558b2f,stroke-width:1px;
    classDef api fill:#e1f5fe,stroke:#0288d1,stroke-width:1px;
    classDef storage fill:#fffde7,stroke:#fbc02d,stroke-width:1px;
    classDef external fill:#ffebee,stroke:#c62828,stroke-width:1px,stroke-dasharray: 4 4;

    User([User]):::client
    RequestReset["POST /api/auth/forgot-password<br>(Email)"]:::api
    SqlUser["SQL Server: dbo.Users<br>(Verify user exists by email)"]:::storage
    TableToken["Azure Table: PasswordResetTokens<br>(Insert PK='PasswordResetTokens', RK=HashedToken, UserId)"]:::storage
    SendGrid["SendGrid Email Service<br>(Send reset link + raw token)"]:::external
    GenericResponse["Return 200 OK generic response"]:::api
    
    SubmitReset["POST /api/auth/reset-password<br>(Raw Token + New Password)"]:::api
    GetToken["Azure Table: PasswordResetTokens<br>(Retrieve RK = SHA256 of Raw Token)"]:::storage
    Validate{"Is Token Valid &<br>Not Expired?"}
    Error["Return Error Response"]:::api
    UpdateSql["SQL Server: dbo.Users<br>(Update PasswordHash for User)"]:::storage
    MarkUsed["Azure Table: PasswordResetTokens<br>(Update UsedAtUtc = Now)"]:::storage
    Success["Return 200 OK Success"]:::api

    %% Forgot Password Flow
    User --> RequestReset
    RequestReset --> SqlUser
    SqlUser --> TableToken
    TableToken --> SendGrid
    TableToken --> GenericResponse
    SendGrid --> User

    %% Reset Password Flow
    User --> SubmitReset
    SubmitReset --> GetToken
    GetToken --> Validate
    Validate -- No --> Error
    Validate -- Yes --> UpdateSql
    UpdateSql --> MarkUsed
    MarkUsed --> Success
