    {
      "id": "L-XFZtZH2vN8-nGvJzfsT",
      "type": "text",
      "x": 90.69111120403159,
      "y": -322.2836846176921,
      "width": 329.01666259765625,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
