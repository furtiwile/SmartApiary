    {
      "id": "q6svatCEYkmFt6jZvS50u",
      "type": "text",
      "x": 4232.818884912795,
      "y": 245.44250585850068,
      "width": 532.4833374023438,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2c",
      "roundness": null,
      "seed": 1029812078,
      "version": 286,
      "versionNonce": 420201646,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782220327925,
      "link": null,
      "locked": false,
      "text": "EVENTS\n\nAnomalyDetectedDomainEvent.cs\n Triggered when telemetry records a sudden weight\ndrop (harvesting, theft, or swarming).\n\nBatteryLowDomainEvent.cs\n Triggered when a scale's battery reports falling below\ncritical thresholds (< 15%).\n\nPesticideWarningDomainEvent.cs\n Triggered when a new pesticide spraying is scheduled,\nprompting nearby beekeeper warnings.\n\nPesticideWarningCancelledDomainEvent.cs\n Triggered when a scheduled spraying is cancelled,\ninforming nearby beekeepers of the change.\n\nNotificationCreatedDomainEvent.cs\n Triggered when any notification is successfully\ngenerated within the system.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "cp5tycl_aSYd58h6ztJPs",
      "originalText": "EVENTS\n\nAnomalyDetectedDomainEvent.cs\n Triggered when telemetry records a sudden weight drop (harvesting, theft, or swarming).\n\nBatteryLowDomainEvent.cs\n Triggered when a scale's battery reports falling below critical thresholds (< 15%).\n\nPesticideWarningDomainEvent.cs\n Triggered when a new pesticide spraying is scheduled, prompting nearby beekeeper warnings.\n\nPesticideWarningCancelledDomainEvent.cs\n Triggered when a scheduled spraying is cancelled, informing nearby beekeepers of the change.\n\nNotificationCreatedDomainEvent.cs\n Triggered when any notification is successfully generated within the system.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qqyP9esg74YGJKNGPKdCk",
      "type": "rectangle",
      "x": 4211.0605536139665,
      "y": 914.4425058585007,
