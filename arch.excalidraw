      "versionNonce": 1371405486,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782222111438,
      "link": null,
      "locked": false,
      "text": "BEEKEPER LOGIC\n\nHiveInspections: Records and\nretrieves hive health inspections.\n\nHives: Manages hive configurations\nand pairing links to physical devices.\n\nApiaries: Manages beekeeping yard\ndetails, location, and owner\nassociations.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "PdIs-VZnUkeqsaIBlaKSf",
      "originalText": "BEEKEPER LOGIC\n\nHiveInspections: Records and retrieves hive health inspections.\n\nHives: Manages hive configurations and pairing links to physical devices.\n\nApiaries: Manages beekeeping yard details, location, and owner associations.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
